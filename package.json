{
  "name": "vue-panel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "prebuild:panel": "node scripts/clean-integration-engine.mjs",
    "build:panel": "vue-tsc -b && vite build --config vite.panel.config.ts",
    "postbuild:panel": "node scripts/verify-integration-engine.mjs",
    "build:integration": "npm.cmd run build:panel",
    "test:python": "python -m unittest discover -s tests -p test_*.py",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@mdi/font": "^7.4.47",
    "codemirror": "^6.0.2",
    "css-tree": "^3.2.1",
    "home-assistant-js-websocket": "^9.6.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
